<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/dp_16">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:src="@drawable/ic_avatar_placeholder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:text="@string/profile_username_default"
                android:textColor="@color/app_on_surface"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
                app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                app:layout_constraintTop_toTopOf="@+id/iv_avatar" />

            <TextView
                android:id="@+id/tv_uid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_username_default"
                android:textColor="@color/app_on_surface"
                android:textSize="@dimen/sp_13"
                app:layout_constraintEnd_toEndOf="@+id/tv_username"
                app:layout_constraintStart_toStartOf="@+id/tv_username"
                app:layout_constraintTop_toBottomOf="@+id/tv_username" />

            <TextView
                android:id="@+id/tv_score_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="积分"
                android:textColor="@color/app_on_surface"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/iv_avatar"
                app:layout_constraintStart_toStartOf="@+id/iv_avatar"
                app:layout_constraintTop_toBottomOf="@+id/iv_avatar" />

            <TextView
                android:id="@+id/tv_coin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/red_btn_bg_color"
                android:textSize="@dimen/sp_13"
                app:layout_constraintEnd_toEndOf="@+id/iv_avatar"
                app:layout_constraintStart_toStartOf="@+id/iv_avatar"
                app:layout_constraintTop_toBottomOf="@+id/tv_score_des" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_score_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:text="明细"
                android:textColor="@color/app_on_surface"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="end"
                app:iconTint="@color/text_color_black"
                app:layout_constraintBottom_toBottomOf="@+id/tv_coin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_score_des" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_10"
                app:layout_constraintTop_toBottomOf="@+id/btn_score_detail">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_collect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:gravity="center_vertical"
                    android:insetTop="@dimen/dp_0"
                    android:insetBottom="@dimen/dp_0"
                    android:text="@string/profile_collect"
                    android:textColor="@color/app_on_surface"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/app_surface"
                    app:cornerRadius="@dimen/dp_99"
                    app:icon="@drawable/ic_star_empty"
                    app:iconSize="@dimen/sp_16"
                    app:iconTint="@color/app_on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:gravity="center_vertical"
                    android:insetTop="@dimen/dp_0"
                    android:insetBottom="@dimen/dp_0"
                    android:text="@string/my_rank"
                    android:textColor="@color/app_on_surface"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/app_surface"
                    app:cornerRadius="@dimen/dp_99"
                    app:icon="@drawable/icon_rank"
                    app:iconSize="@dimen/sp_16"
                    app:iconTint="@color/app_on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:gravity="center_vertical"
                    android:insetTop="@dimen/dp_0"
                    android:insetBottom="@dimen/dp_0"
                    android:text="@string/profile_about"
                    android:textColor="@color/app_on_surface"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/app_surface"
                    app:cornerRadius="@dimen/dp_99"
                    app:icon="@drawable/icon_about"
                    app:iconSize="@dimen/sp_16"
                    app:iconTint="@color/app_on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:background="@drawable/shape_logout"
                    android:gravity="center"
                    android:insetTop="@dimen/dp_0"
                    android:insetBottom="@dimen/dp_0"
                    android:text="@string/profile_logout"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@null"
                    app:cornerRadius="@dimen/dp_99"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconSize="@dimen/sp_16"
                    app:iconTint="@color/white" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


</FrameLayout>
