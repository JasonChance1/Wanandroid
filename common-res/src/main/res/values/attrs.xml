<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TitleBar">
        <attr name="title" format="string" />
        <!--        右侧图标1，不设置不显示-->
        <attr name="icon1" format="reference" />
        <!--        右侧图标2，不设置不显示-->
        <attr name="icon2" format="reference" />
        <!--        标题颜色-->
        <attr name="titleColor" format="reference|color" />
        <!--        图标大小-->
        <attr name="iconSize" format="dimension" />
        <!--        返回图标-->
        <attr name="backIcon" format="reference" />
        <!--        图标颜色-->
        <attr name="iconTint" format="reference|color" />
        <!--        返回图标颜色，不设置默认用iconTint-->
        <attr name="backIconTint" format="reference|color" />
        <!--        返回图标的大小，不设置默认为iconSize-->
        <attr name="backIconSize" format="dimension" />
        <!--        右侧文字，不设置不显示-->
        <attr name="text1" format="string" />
        <!--        右侧文字颜色-->
        <attr name="text1Color" format="reference|color" />
    </declare-styleable>

    <declare-styleable name="SearchButton">
        <attr name="btnColor" format="color|reference" />
    </declare-styleable>
</resources>